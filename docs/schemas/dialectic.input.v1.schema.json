{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dialectic.input.v1",
  "title": "Dialectic Player Input",
  "type": "object",
  "required": ["schema", "player", "text", "game"],
  "properties": {
    "schema": { "const": "dialectic.input.v1" },
    "npc": { "type": "string" },
    "npc_id": { "type": "string" },
    "player": { "type": "string", "minLength": 1 },
    "text": { "type": "string" },
    "skip_player_tts": { "type": "boolean" },
    "dialectic_mode": { "type": "string" },
    "mode": { "type": "string" },
    "target": { "$ref": "dialectic.common.v1.schema.json#/$defs/actorRef" },
    "player_actor": { "$ref": "dialectic.common.v1.schema.json#/$defs/actorRef" },
    "audience_snapshot": { "$ref": "dialectic.common.v1.schema.json#/$defs/audienceSnapshot" },
    "request_id": { "type": "string" },
    "game": { "const": "fnv" }
  },
  "additionalProperties": true
}
